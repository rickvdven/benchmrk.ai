{
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/nl/gids",
      "destination": "/nl/gids/index.html"
    },
    {
      "source": "/nl/gids/:slug",
      "destination": "/nl/gids/:slug/index.html"
    },
    {
      "source": "/nl/:slug",
      "destination": "/nl/:slug/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/content-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 5 * * *"
    }
  ]
}
