{
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/nl/gids",
      "destination": "/nl/gids/index.html"
    },
    {
      "source": "/nl/gids/:slug",
      "destination": "/nl/gids/:slug/index.html"
    },
    {
      "source": "/nl/:slug",
      "destination": "/nl/:slug/index.html"
    },
    {
      "source": "/en/guide",
      "destination": "/en/guide/index.html"
    },
    {
      "source": "/en/guide/:slug",
      "destination": "/en/guide/:slug/index.html"
    },
    {
      "source": "/en/:slug",
      "destination": "/en/:slug/index.html"
    },
    {
      "source": "/de/ratgeber",
      "destination": "/de/ratgeber/index.html"
    },
    {
      "source": "/de/ratgeber/:slug",
      "destination": "/de/ratgeber/:slug/index.html"
    },
    {
      "source": "/de/:slug",
      "destination": "/de/:slug/index.html"
    },
    {
      "source": "/es/guia",
      "destination": "/es/guia/index.html"
    },
    {
      "source": "/es/guia/:slug",
      "destination": "/es/guia/:slug/index.html"
    },
    {
      "source": "/es/:slug",
      "destination": "/es/:slug/index.html"
    },
    {
      "source": "/ko/guide",
      "destination": "/ko/guide/index.html"
    },
    {
      "source": "/ko/guide/:slug",
      "destination": "/ko/guide/:slug/index.html"
    },
    {
      "source": "/ko/:slug",
      "destination": "/ko/:slug/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/content-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/demo/roxengine-demo-nl.mp4",
      "destination": "/demo/benchmrk-demo-nl.mp4",
      "permanent": true
    },
    {
      "source": "/demo/roxengine-demo-nl.srt",
      "destination": "/demo/benchmrk-demo-nl.srt",
      "permanent": true
    },
    {
      "source": "/demo/roxengine-demo-nl.vtt",
      "destination": "/demo/benchmrk-demo-nl.vtt",
      "permanent": true
    }
  ]
}
